# Copy to .env on the SERVER only. Never commit credentials or use VITE_ prefixes.
# Generate a private connection key: openssl rand -hex 32
POLYPLAN_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio SMS-capable sender and your verified recipient, in +countrycode format.
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=
APP_ORIGIN=http://localhost:5173
PORT=3001
